<?xml version="1.0" encoding="UTF-8"?>
<!--
    Assembly descriptor for the TestRunner self-contained JAR.

    Produces target/${project.artifactId}-${project.version}-tests-jar-with-dependencies.jar.
    Contains:
      - Main classes from target/classes
      - Test classes and test resources from target/test-classes
      - All test-scope dependencies (compile + runtime + provided + test) unpacked in the root
    Manifest's Main-Class is com.example.demo.TestRunner (set by maven-assembly-plugin config).
-->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0
                              http://maven.apache.org/xsd/assembly-2.1.0.xsd">

    <id>tests-jar-with-dependencies</id>

    <formats>
        <format>jar</format>
    </formats>

    <includeBaseDirectory>false</includeBaseDirectory>

    <fileSets>
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${project.build.testOutputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
        </fileSet>
    </fileSets>

    <dependencySets>
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <unpack>true</unpack>
            <scope>test</scope>
            <useProjectArtifact>false</useProjectArtifact>
            <unpackOptions>
                <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                </excludes>
            </unpackOptions>
        </dependencySet>
    </dependencySets>

</assembly>
