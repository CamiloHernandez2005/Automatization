# Plantilla del archivo .env. Copiar a `.env` (mismo directorio, raíz del
# proyecto) y reemplazar los placeholders con valores reales.
#
# spring-dotenv carga `.env` al arrancar Spring Boot y resuelve los
# placeholders ${...} de src/main/resources/application.properties.

# Credenciales de SQL Server (consumidas por spring.datasource.username/password)
DB_USERNAME=<tu-usuario-db>
DB_PASSWORD=<tu-password-db>

# Secreto para firmar/verificar JWT y duración del token en milisegundos.
JWT_SECRET=<una-cadena-larga-aleatoria>
JWT_EXPIRATION=86400000

# --- LOGIN TEST (Sales Portal) ---
BASE_URL=http://<host>:<port>/login
LOGIN_USERNAME=<tu-usuario-test>
LOGIN_PASSWORD=<tu-password-test>

# --- Playwright Config ---
HEADLESS=true

# --- PC Terminal Test ---
PCTERM_LOGIN_USERNAME=<usuario-pcterminal>
PCTERM_LOGIN_PASSWORD=<password-pcterminal>
PCTERM_PRODUCT=<producto-a-buscar>

# Tipo de flujo: TOP_UP | PIN | BILL_PAYMENT | CRYPTO | ACTIVATION | PORT_IN | TOOL
PCTERM_FLOW_TYPE=TOP_UP

# Flag global del clerkId (aplica a todos los flujos)
PCTERM_CLERK_ENABLED=false
PCTERM_CLERK_ID=

# TOP_UP
PCTERM_PHONE_ENABLED=false
PCTERM_PHONE_NUMBER=
PCTERM_AMOUNT=

# PIN
PCTERM_PIN_AMOUNT=

# BILL_PAYMENT
PCTERM_BILL_ACCOUNT=
PCTERM_BILL_AMOUNT=

# CRYPTO
PCTERM_CRYPTO_WALLET=
PCTERM_CRYPTO_AMOUNT=

# ACTIVATION
PCTERM_ACT_ICCID=
PCTERM_ACT_IMEI=

# PORT_IN
PCTERM_PORTIN_NUMBER=
PCTERM_PORTIN_CARRIER=
PCTERM_PORTIN_ACCOUNT=
PCTERM_PORTIN_PIN=
